{
    "name": "server",
    "private": true,
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "proxy": "http://localhost:4242",
    "scripts": {
        "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
        "prisma:push": "prisma db push --schema=src/prisma/schema.prisma",
        "migrate:deploy": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 prisma migrate deploy",
        "migrate:dev": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 prisma migrate dev",
        "postinstall": "prisma generate --schema=src/prisma/schema.prisma",
        "test": "jest",
        "coverage:webhook-handler": "jest --coverage --collectCoverageFrom=src/controllers/stripeWebhook.controller.ts --collectCoverageFrom=src/services/stripe-webhook/intent-handlers/CheckoutSessionCompleted.ts",
        "test:e2e": "jest ----testPathPatterns=./e2e",
        "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --format=esm --packages=external",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "db:repair-prisma-migration": "prisma db execute --file prisma/repair_modified_migration.sql && prisma migrate deploy",
        "db:fix-subscription-plan-enum": "prisma db execute --file prisma/fix_subscription_plan_enum_drift.sql"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.980.0",
        "@aws-sdk/s3-request-presigner": "^3.980.0",
        "@hono/node-server": "^2.0.3",
        "@hono/trpc-server": "^0.4.2",
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.3.0",
        "@trpc/server": "^11.17.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express-session": "^1.18.2",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.0.3",
        "@types/passport": "^1.0.17",
        "@types/pdfkit": "^0.17.4",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^6.0.3",
        "adm-zip": "^0.5.16",
        "archiver": "^7.0.1",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.1.0",
        "express-session": "^1.18.2",
        "fflate": "^0.8.2",
        "googleapis": "^171.4.0",
        "hono": "^4.12.21",
        "jest": "^30.2.0",
        "jsonwebtoken": "^9.0.2",
        "jszip": "^3.10.1",
        "mammoth": "^1.13.0",
        "multer": "^2.0.2",
        "passport": "^0.7.0",
        "pdfjs-dist": "^6.4.299",
        "pdfkit": "^0.17.2",
        "pg": "^8.16.3",
        "prisma": "^7.4.0",
        "resend": "^6.8.0",
        "stripe": "^22.1.0",
        "supertest": "^7.1.4",
        "swr": "^2.4.0",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.7",
        "@types/archiver": "^7.0.0"
    },
    "prisma": {
        "schema": "src/prisma/schema.prisma",
        "seed": "tsx src/prisma/seed.ts"
    }
}

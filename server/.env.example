# Standard local setup: copy this file once, then leave the values as-is.
#   cp server/.env.example server/.env
#
# These values match docker-compose.yml (Postgres on localhost:5432).
# Placeholders for Resend/Stripe are enough to boot the API and use the app.
# Real Resend/Stripe keys are only required if you actually send email or charge cards.

DATABASE_URL=postgresql://handwerk:handwerk@localhost:5432/handwerk_hr
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_REFRESH_SECRET=local-dev-jwt-refresh-secret-change-me
EMAIL_SENDER=no-reply@example.com
RESEND_API_KEY=re_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

  destinations TeamsSendDestination[]
  @@map("teams_sends")
}

model TeamsSendDestination {
  id String @id @default(uuid())
  sendId String @map("send_id")
  teamId String @map("team_id")
  channelId String @map("channel_id")
  label String
  status String @default("pending")
  graphMessageId String? @map("graph_message_id")
  messageUrl String? @map("message_url")
  error String?
  retryAfter DateTime? @map("retry_after") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  send TeamsSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  @@unique([sendId, teamId, channelId])
  @@map("teams_send_destinations")
}
